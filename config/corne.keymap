#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "Home Row Mods";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <16 15 14 13 19 20 21 22>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <250>;
        };

        hrm_pinky: hrm_pinky {
            compatible = "zmk,behavior-hold-tap";
            label = "Home Row Mods (Pinky)";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <16 15 14 13 19 20 21 22>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <300>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W             &kp E              &kp R            &kp T        &kp Y      &kp U             &kp I               &kp O              &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S             &kp D              &kp F            &kp G        &kp H      &hrm RCTRL J      &hrm RIGHT_SHIFT K  &hrm RIGHT_META L  &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X             &kp C              &kp V            &kp B        &kp N      &hrm RIGHT_ALT M  &kp COMMA           &kp DOT            &kp FSLH  &kp ESC
                                    &kp LALT           &mo 2            &kp ENTER    &kp SPACE  &mo 1             &kp RIGHT_GUI
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp TAB    &kp AMPS         &kp AT        &kp SLASH  &kp BACKSLASH  &kp CARET               &kp HOME        &kp PAGE_DOWN      &kp PG_UP        &kp END     &kp C_MUTE        &kp BSPC
&kp LCTRL  &kp EXCLAMATION  &kp QUESTION  &kp HASH   &kp DOLLAR     &kp PERCENT             &kp LEFT        &kp DOWN           &kp UP           &kp RIGHT   &kp COLON         &kp DEL
&kp LSHFT  &kp GRAVE        &trans        &trans     &kp C_BRI_DEC  &kp C_BRIGHTNESS_INC    &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &kp C_PLAY_PAUSE  &kp ESC
                                          &kp LALT   &mo 5          &kp ENTER               &kp SPACE       &trans             &kp RIGHT_GUI
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp TAB    &kp KP_MULTIPLY  &kp N7  &kp N8    &kp N9  &kp MINUS    &kp UNDER     &kp EQUAL      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE          &kp BSPC
&kp LCTRL  &kp KP_DIVIDE    &kp N4  &kp N5    &kp N6  &kp PLUS     &kp MINUS     &kp PLUS       &kp LBKT              &kp RBKT               &kp COLON         &kp DEL
&kp LSHFT  &kp N0           &kp N1  &kp N2    &kp N3  &kp DOT      &kp ASTERISK  &kp LESS_THAN  &kp LBRC              &kp RBRC               &kp GREATER_THAN  &kp TILDE
                                    &kp LALT  &mo 5   &kp ENTER    &kp SPACE     &mo 5          &kp RIGHT_GUI
            >;
        };

        // Toggled on/off with &tog 3 (Y key on the fn layer). Left hand is the
        // default layout with Space on the inner thumb and the game numpad on
        // the middle thumb. Right hand is spelled out as plain keys so that it
        // does not fall through to the home-row mods on the base layer. Enter
        // and Space swap sides. The right middle thumb is transparent, which
        // reaches &mo 1 on the base layer, but the lower layer (index 1) is
        // masked by this layer (index 3) so that key does nothing while gaming.
        gaming_layer {
            display-name = "Game";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U      &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &kp LALT  &mo 4  &kp SPACE    &kp ENTER  &trans     &kp RIGHT_GUI
            >;
        };

        // Held from the gaming layer's middle thumb. Same numpad shape as the
        // raise layer; the shift position holds the fn layer, which turns the
        // numpad into F-keys in the same columns.
        game_numpad_layer {
            display-name = "GameNum";
            bindings = <
&trans  &kp KP_MULTIPLY  &kp N7  &kp N8  &kp N9  &kp MINUS    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp KP_DIVIDE    &kp N4  &kp N5  &kp N6  &kp PLUS     &trans  &trans  &trans  &trans  &trans  &trans
&mo 5   &kp N0           &kp N1  &kp N2  &kp N3  &kp DOT      &trans  &trans  &trans  &trans  &trans  &trans
                                 &trans  &trans  &trans       &trans  &trans  &trans
            >;
        };

        // Must stay the highest-index layer: it is reached while the gaming
        // and game-numpad layers are also active, and the highest index wins.
        fn_layer {
            display-name = "Fn";
            bindings = <
&sys_reset  &bootloader  &kp F7  &kp F8    &kp F9  &kp F10      &tog 3     &trans  &trans    &trans  &trans  &bt BT_CLR
&trans      &trans       &kp F4  &kp F5    &kp F6  &kp F11      &trans     &trans  &trans    &trans  &trans  &trans
&kp RSHFT   &trans       &kp F1  &kp F2    &kp F3  &kp F12      &trans     &trans  &trans    &trans  &trans  &kp ESC
                                 &kp LALT  &trans  &kp ENTER    &kp SPACE  &trans  &kp RGUI
            >;
        };
    };
};
